<?xml version='1.0' encoding='UTF-8'?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="hachitech" translate="label" sortOrder="90">
            <label>Hachitechs</label>
        </tab>
        <section id="hachitech_hideguard" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>HideGuard</label>
            <tab>hachitech</tab>
            <resource>Hachitechs_Hideguard::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Protection</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="public_key" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Public Key</label>
                    <comment>Public HideGuard SDK site key used by the storefront.</comment>
                    <config_path>hachitech_hideguard/production/public_key</config_path>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <comment model="Hachitechs\Hideguard\Model\Config\Comment\ApiKey"/>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <config_path>hachitech_hideguard/production/api_key</config_path>
                </field>
                <field id="signature_public_key" translate="label comment" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Signature Public Key</label>
                    <comment>Ed25519 PEM public key issued for this site. Never enter a private signing key. Kept on the server.</comment>
                    <config_path>hachitech_hideguard/production/signature_public_key</config_path>
                </field>
                <field id="protected_paths" translate="label comment" type="textarea" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional Protected Paths</label>
                    <comment>All storefront pages are protected automatically. Existing path rules remain supported. One storefront path per line, without a query string. Wildcards are supported, for example *, customer/*, contact, category/*. Maximum 50 rules. Gate and verification endpoints remain reachable.</comment>
                </field>
                <field id="block_duration" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Block Duration</label>
                    <source_model>Hachitechs\Hideguard\Model\Config\Source\Duration</source_model>
                    <comment>Repeated reports do not extend an active block. Allow and Challenge cannot remove it.</comment>
                </field>
                <field id="pass_duration" translate="label comment" type="select" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>HideGuard Recheck Interval</label>
                    <source_model>Hachitechs\Hideguard\Model\Config\Source\PassDuration</source_model>
                    <comment>Always checks on each protected page load. Timed options set how long a pass remains valid before HideGuard is called again. Page visits do not extend the pass.</comment>
                </field>
                <field id="debug" translate="label comment" type="select" sortOrder="46" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debug Log</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Log backend HideGuard verdict API requests, response summaries and connection errors to var/log/hachitechs_hideguard_debug.log. Credentials are excluded and visitor IDs are hashed. Disabled by default.</comment>
                </field>
                <field id="reset_blocks" translate="label comment" type="button" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Block List</label>
                    <comment>Reset blocks for the selected store scope. At Default Config this resets all store views. Settings and existing grants are preserved.</comment>
                    <frontend_model>Hachitechs\Hideguard\Block\Adminhtml\System\Config\ResetBlocks</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
