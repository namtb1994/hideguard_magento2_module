    'error' => [__('Unable to verify access'), __('Access could not be verified. Please try again.')],
    default => [__('Verifying access'), __('Please wait for verification before continuing.')],
};
?>
<section id="hachitech-hideguard-gate"
         class="hachitech-hideguard-gate"
         data-page="<?= $escaper->escapeHtmlAttr($block->getData('gate_page') ? 'gate' : '') ?>"
         data-state="<?= $escaper->escapeHtmlAttr($state) ?>"
         role="dialog"
         aria-modal="true"
         aria-labelledby="hachitech-hideguard-heading"
         aria-describedby="hachitech-hideguard-description">
    <div class="hachitech-hideguard-message">
        <div class="hachitech-hideguard-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path d="M12 3 4 6v5c0 5.2 3.4 8.6 8 10 4.6-1.4 8-4.8 8-10V6l-8-3Z"/>
                <rect x="9" y="10" width="6" height="5" rx="1"/>
                <path d="M10 10V8a2 2 0 0 1 4 0v2"/>
            </svg>
        </div>
        <span class="hachitech-hideguard-eyebrow"><?= $escaper->escapeHtml(__('Protected access')) ?></span>
