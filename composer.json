{
    "name": "hachitechs/hideguard-m2",
    "description": "HideGuard storefront and business action protection for Magento 2",
    "type": "magento2-module",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "hachitechs/hideguard-php": "^1.0",
        "magento/framework": "^103.0.7",
        "magento/module-backend": "^102.0",
        "magento/module-checkout": "^100.4",
        "magento/module-config": "^101.2",
        "magento/module-cron": "^100.4",
        "magento/module-csp": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-integration": "^100.4",
        "magento/module-page-cache": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-store": "^101.1",
        "magento/module-theme": "^101.0",
        "magento/module-url-rewrite": "^102.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hachitechs\\Hideguard\\": ""
        },
        "exclude-from-classmap": [
            "Test/"
        ]
    }
}
